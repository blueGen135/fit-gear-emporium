<div class="h-[200px] bg-black">
    <div class="max-w-7xl mx-auto flex items-end h-full">
        <div class="p-6">
            <h1 class="text-white text-2xl md:text-4xl">Search Results</h1>
            <a href="/" class="text-white text-lg md:text-2xl">Home</a>
        </div>
    </div>
</div>
<div class="max-w-7xl mx-auto p-2 py-10">
{% paginate search.results by 10 %}
 <div class="flex justify-center items-center py-10">
      <form action="{{ routes.search_url }}" method="get" class="border flex rounded">
        <input type="search" name="q" placeholder="Search" value="{{ search.terms | escape }}" class="px-4 py-2 w-80 border-none">

        <button type="submit" class="bg-gray-900 hover:bg-gray-700 text-white border px-4">Search</button>
      </form>
    </div>
   
    {% if search.performed %}

        <p class="text-center py-5 text-2xl font-semibold">
            {{ search.results.size }} results for the search term {{ search.terms }}
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {% for item in search.results %}
                {% render 'product-card', productCard: item %}
            {% endfor %}
        </div>
    {% else %}    
        <div class="text-center my-4">
            <p>No results found for the search term:
            {{ search.terms | escape }}
            . Try to use a different keyword</p>
        </div>
    {% endif %}
    {% render 'pagination', pagination: paginate %}
    {% endpaginate %}
</div>